{
  "schemaVersion": 3,
  "kind": "groundhog-simulation",
  "name": "local-fibonacci-event-heavy",
  "seed": "sim-local-fibonacci-event-heavy",
  "target": {
    "provider": "local"
  },
  "loadShape": [
    {
      "duration": "20s",
      "users": 2,
      "ratePerUserHz": 1.5
    }
  ],
  "workloads": [
    {
      "name": "contract-call",
      "weight": 3
    },
    {
      "name": "events-query",
      "weight": 7
    }
  ],
  "contractArtifacts": [
    {
      "name": "fibonacci",
      "artifact": {
        "kind": "rv32",
        "path": "fibonacci.rv32a"
      }
    }
  ],
  "contractCalls": [
    {
      "name": "fib-compute-10",
      "contract": "fibonacci",
      "entrypoint": {
        "interface": "Fibonacci",
        "version": "0.1.0",
        "method": "compute"
      },
      "calldata": "0x0a"
    }
  ],
  "eventQueries": [
    {
      "name": "fib-events",
      "contract": "fibonacci",
      "order": "descending",
      "anchor": {
        "kind": "atEnd"
      },
      "cursor": "0x",
      "limit": 100,
      "expectMinEvents": 1
    }
  ],
  "assertions": {
    "maxErrorRate": 0.001
  },
  "accounts": {
    "kind": "native",
    "seed": "sim-local-fibonacci-event-heavy:fixture-accounts",
    "funding": "pre-funded",
    "minimumBalanceRaw": "100000000",
    "deploymentCollateralRaw": "100000000",
    "fundingAmountRaw": "1000000000"
  }
}
