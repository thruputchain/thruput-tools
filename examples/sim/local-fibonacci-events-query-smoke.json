{
  "schemaVersion": 2,
  "kind": "groundhog-simulation",
  "name": "local-fibonacci-events-query-smoke",
  "seed": "sim-local-fibonacci-events-query-smoke",
  "target": {
    "provider": "local"
  },
  "bootstrap": {
    "accounts": 1,
    "accountSeed": "sim-local-fibonacci-events-query-smoke-accounts",
    "initialStorageTokens": "1000000000",
    "devWalletProfile": "default",
    "storageCostProfile": "default"
  },
  "loadShape": [
    {
      "duration": "3s",
      "users": 1,
      "ratePerUserHz": 1.0
    }
  ],
  "workloads": [
    {
      "name": "events-query",
      "weight": 1
    }
  ],
  "contractArtifacts": [
    {
      "name": "fibonacci",
      "artifact": {
        "kind": "wasm",
        "path": "fibonacci.wasm"
      }
    }
  ],
  "eventQueries": [
    {
      "name": "fib-events",
      "contract": "fibonacci",
      "order": "descending",
      "anchor": {
        "kind": "atEnd"
      },
      "cursor": "0x",
      "limit": 10,
      "expectMinEvents": 0
    }
  ],
  "assertions": {
    "maxErrorRate": 0.001
  }
}
