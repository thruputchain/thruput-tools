[package]
name = "groundhog-dev-wallet"
version = "0.1.0"
edition = "2024"
license = "Apache-2.0"
description = "Dev-mode wallet contract for the Groundhog local dev node"

# Prevent cargo from attaching to any parent workspace when
# cross-compiled inside a build script's OUT_DIR.
[workspace]

[lib]
crate-type = ["cdylib", "rlib"]

[features]
default = ["dev", "entrypoints"]
dev = []
entrypoints = []

[dependencies]
sdk = { version = "0.13", registry = "groundhog", features = ["alloc"] }
xdrs = { version = "0.5", registry = "groundhog", features = ["alloc"] }

# sdk 0.13.0 was built against groundhog-xdr 0.9.3 (its 2-arg
# raw_Return ABI).  protocol-rs 0.9.4 added a third arg.  Force the
# 0.9.3 resolution so the dev-wallet WASM compiles cleanly until sdk
# bumps to follow protocol-rs.
[dependencies.groundhog-xdr]
version = "=0.9.3"
registry = "groundhog"

[profile.release]
opt-level = 3
lto = true
codegen-units = 1
strip = "symbols"
overflow-checks = false
debug = false
panic = "abort"
