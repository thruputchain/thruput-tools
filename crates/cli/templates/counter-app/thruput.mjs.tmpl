import { spawn } from "node:child_process";
import { copyFile, mkdir } from "node:fs/promises";

const cli = process.env.THRUPUT_CLI ?? "thruput";
let child;

// The CLI and its build children belong to this process group, never the user's node.
function stopChild(signal) {
  if (!child?.pid) return;
  try {
    if (process.platform === "win32") child.kill(signal);
    else process.kill(-child.pid, signal);
  } catch (error) {
    if (error.code !== "ESRCH") throw error;
  }
}

export async function command(executable, args) {
  return new Promise((resolve, reject) => {
    child = spawn(executable, args, {
      stdio: ["ignore", "pipe", "inherit"],
      detached: process.platform !== "win32",
    });
    let stdout = "";
    child.stdout.setEncoding("utf8");
    child.stdout.on("data", (chunk) => {
      stdout += chunk;
    });
    child.once("error", reject);
    child.once("close", (code) => {
      child = undefined;
      resolve({ code, stdout });
    });
  });
}

export async function thruput(args, { allowWarnings = false } = {}) {
  let result;
  try {
    result = await command(cli, [...args, "--json", "--non-interactive"]);
  } catch (error) {
    if (error.code === "ENOENT")
      throw new Error("Install the Thruput CLI and run thruput init.");
    throw error;
  }
  let report;
  try {
    report = JSON.parse(result.stdout);
  } catch {
    throw new Error(
      `thruput ${args[0]} failed. See the CLI diagnostic above.`,
    );
  }
  if (!report.ok || (result.code !== 0 && !allowWarnings)) {
    throw new Error(report.error?.message ?? `thruput ${args[0]} failed.`);
  }
  return report.data;
}

export async function buildContract() {
  const report = await thruput(["build", "--bindings", "ts"]);
  if (
    typeof report.bindingsTs !== "string" ||
    typeof report.rv32 !== "string"
  ) {
    throw new Error(
      "The contract build did not produce an artifact and TypeScript bindings.",
    );
  }
  await mkdir("web/generated", { recursive: true });
  await copyFile(report.bindingsTs, "web/generated/counter.ts");
  return report;
}

export function onShutdown(close = async () => {}) {
  for (const signal of ["SIGINT", "SIGTERM"]) {
    process.once(signal, async () => {
      stopChild(signal);
      await close();
      process.exit(signal === "SIGINT" ? 130 : 143);
    });
  }
}
