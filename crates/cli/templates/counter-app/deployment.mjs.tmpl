import { readFile } from "node:fs/promises";
import {
  createThruputClient,
  addressFromBase58,
  hashFromBase58,
  localnet,
} from "@thruputchain/client";

export async function readDeployment() {
  let config;
  try {
    config = JSON.parse(await readFile(".thruput/app.json", "utf8"));
  } catch (error) {
    if (error.code === "ENOENT")
      throw new Error(
        "No saved deployment. Run npm run contract:deploy first.",
      );
    if (error instanceof SyntaxError)
      throw new Error(
        "Invalid saved deployment. Run npm run contract:deploy again.",
      );
    throw new Error(`Could not read .thruput/app.json: ${error.message}`);
  }
  if (
    !config ||
    typeof config !== "object" ||
    typeof config.contractAddress !== "string" ||
    typeof config.txHash !== "string" ||
    typeof config.rpcUrl !== "string" ||
    !URL.canParse(config.rpcUrl) ||
    !["http:", "https:"].includes(new URL(config.rpcUrl).protocol)
  )
    throw new Error(
      "Invalid saved deployment. Run npm run contract:deploy again.",
    );
  try {
    addressFromBase58(config.contractAddress);
    hashFromBase58(config.txHash);
  } catch {
    throw new Error(
      "Invalid saved deployment. Run npm run contract:deploy again.",
    );
  }
  return config;
}

export async function checkDeployment(config) {
  let receipt;
  try {
    const client = await createThruputClient({
      cluster: localnet({ rpcUrl: config.rpcUrl }),
    });
    receipt = await client.getTransactionReceipt({
      transactionHash: hashFromBase58(config.txHash),
    });
  } catch (error) {
    throw new Error(
      `Could not check the saved deployment: ${error.message}. Run thruput node in another terminal and check the saved RPC endpoint.`,
    );
  }
  if (!receipt)
    throw new Error(
      "Saved deployment is unavailable on this node. Run npm run contract:deploy again, then reload the browser.",
    );
}
