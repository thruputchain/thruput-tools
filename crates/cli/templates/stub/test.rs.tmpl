use thruput_sdk::*;

use {{PROJECT_NAME_SNAKE}}::{ContractClient, register_mock_contract};

static NONCE: SHA256Hash = thruput_sdk::sha256_static!("{{PROJECT_NAME_UPPER_SNAKE}}_NONCE");

#[test]
fn test_deploy() {
    let env = TestEnvironment::no_cost();
    let test_contract = register_mock_contract(&env);
    let contract_hash = *test_contract.as_hash();

    env.transact(|tx| {
        let caller = ContractAddress::named("test_deploy");
        tx.call(&caller).run(move || {
            let address = deploy_contract(&NONCE, &contract_hash);
            ContractClient::new(&address).initialize();
        })
    })
    .assert_success();
}
