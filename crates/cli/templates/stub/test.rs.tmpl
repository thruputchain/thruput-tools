use {{PROJECT_NAME_SNAKE}}::register_mock_contract;
use sdk::*;

static NONCE: SHA256Hash =
    sdk::sha256_static!("{{PROJECT_NAME_UPPER_SNAKE}}_NONCE");

#[test]
fn test_deploy() {
    let env = TestEnvironment::no_cost();
    let test_contract = register_mock_contract(&env);
    let contract_hash = test_contract.as_hash().clone();

    contract_exec(env, move || {
        deploy_contract(
            &NONCE, &contract_hash,
        );
    })
    .unwrap_or_else(|e| panic!("Test failed: {e:?}"));
}
