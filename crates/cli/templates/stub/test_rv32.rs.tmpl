use sdk::*;
use std::path::PathBuf;
use {{PROJECT_NAME_SNAKE}}::ContractClient;

static NONCE: SHA256Hash = sdk::sha256_static!("{{PROJECT_NAME_UPPER_SNAKE}}_RV32_NONCE");

fn groundhog_artifact(file_name: &str) -> PathBuf {
    std::env::var_os("CARGO_TARGET_DIR")
        .map(PathBuf::from)
        .unwrap_or_else(|| PathBuf::from("target"))
        .join("groundhog")
        .join(file_name)
}

#[test]
#[ignore = "requires RV32 build — run via `groundhog test`"]
fn test_deploy_rv32() {
    let contract = load_rv32_contract(groundhog_artifact("{{PROJECT_NAME_SNAKE}}.rv32a"));
    let env = TestEnvironment::no_cost();
    let contract_hash = env.setup_create_contract(&contract);
    let call_addr = ContractAddress::named("{{PROJECT_NAME_SNAKE}}_rv32");

    let result = env.transact(|tx| {
        tx.call(&call_addr).run(|| {
            let address = deploy_contract(&NONCE, &contract_hash);
            ContractClient::new(&address).initialize();
        })
    });

    result.assert_success();
}
