use thruput_sdk::*;
use std::path::PathBuf;

use {{PROJECT_NAME_SNAKE}}::CounterClient;

static NONCE: SHA256Hash = thruput_sdk::sha256_static!("{{PROJECT_NAME_UPPER_SNAKE}}_RV32_NONCE");

fn thruput_artifact(file_name: &str) -> PathBuf {
    std::env::var_os("CARGO_TARGET_DIR")
        .map(PathBuf::from)
        .unwrap_or_else(|| PathBuf::from("target"))
        .join("thruput")
        .join(file_name)
}

#[test]
#[ignore = "requires RV32 build — run via `thruput test`"]
fn test_counter_rv32() {
    let contract = load_rv32_contract(thruput_artifact("{{PROJECT_NAME_SNAKE}}.rv32a"));
    let env = TestEnvironment::no_cost();
    let contract_hash = env.setup_create_contract(&contract);
    let call_addr = ContractAddress::named("{{PROJECT_NAME_SNAKE}}_rv32");

    let result = env.transact(|tx| {
        tx.call(&call_addr).run(|| {
            let addr = deploy_contract(&NONCE, &contract_hash);
            let client = CounterClient::new(&addr);

            assert_eq!(client.get(), 0);
            client.initialize(10);
            assert_eq!(client.get(), 10);

            client.increment(5);
            assert_eq!(client.get(), 15);

            client.decrement(3);
            assert_eq!(client.get(), 12);
        })
    });

    result.assert_success();
}

#[test]
#[ignore = "requires RV32 build — run via `thruput test`"]
fn test_counter_underflow_rv32() {
    let contract = load_rv32_contract(thruput_artifact("{{PROJECT_NAME_SNAKE}}.rv32a"));
    let env = TestEnvironment::no_cost();
    let contract_hash = env.setup_create_contract(&contract);
    let call_addr = ContractAddress::named("{{PROJECT_NAME_SNAKE}}_underflow_rv32");

    env.transact(|tx| {
        tx.call(&call_addr).run(|| {
            let addr = deploy_contract(&NONCE, &contract_hash);
            let client = CounterClient::new(&addr);
            client.initialize(5);

            let err = client.try_decrement(10).expect_err("expected underflow");
            match_exn!(err, {
                LibraryExn::NonNegativeIntUnderflow => {}
                _ => panic!("expected underflow, got: {err:?}"),
            });
            assert_eq!(client.get(), 5);
            client.decrement(5);
            assert_eq!(client.get(), 0);
        })
    })
    .assert_success();
}
