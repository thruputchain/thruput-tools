mod common;

use std::path::PathBuf;
use thruput_sdk::*;

fn thruput_artifact(file_name: &str) -> PathBuf {
    std::env::var_os("CARGO_TARGET_DIR")
        .map(PathBuf::from)
        .unwrap_or_else(|| PathBuf::from("target"))
        .join("thruput")
        .join(file_name)
}

fn setup() -> (TestEnvironmentHandle, SHA256Hash) {
    let contract = load_rv32_contract(thruput_artifact("{{PROJECT_NAME_SNAKE}}.rv32a"));
    let env = TestEnvironment::no_cost();
    let hash = env.setup_create_contract(&contract);
    (env, hash)
}

#[test]
#[ignore = "requires RV32 build — run via `thruput test`"]
fn test_counter_rv32() {
    let (env, hash) = setup();
    common::counter_updates(&env, &hash);
}

#[test]
#[ignore = "requires RV32 build — run via `thruput test`"]
fn test_counter_underflow_rv32() {
    let (env, hash) = setup();
    common::counter_rejects_underflow(&env, &hash);
}

#[test]
#[ignore = "requires RV32 build — run via `thruput test`"]
fn test_counter_event_rv32() {
    let (env, hash) = setup();
    common::counter_emits_ping(&env, &hash);
}
