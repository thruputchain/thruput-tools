mod common;

use {{PROJECT_NAME_SNAKE}}::register_mock_contract;
use thruput_sdk::*;

fn setup() -> (TestEnvironmentHandle, SHA256Hash) {
    let env = TestEnvironment::no_cost();
    let contract = register_mock_contract(&env);
    let hash = *contract.as_hash();
    (env, hash)
}

#[test]
fn test_counter() {
    let (env, hash) = setup();
    common::counter_updates(&env, &hash);
}

#[test]
fn test_counter_underflow() {
    let (env, hash) = setup();
    common::counter_rejects_underflow(&env, &hash);
}

#[test]
fn test_counter_event() {
    let (env, hash) = setup();
    common::counter_emits_ping(&env, &hash);
}
