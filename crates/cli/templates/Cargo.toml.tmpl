[package]
name = "{{PROJECT_NAME}}"
version = "0.1.0"
edition = "2024"

[lib]
crate-type = ["cdylib", "rlib"]
doctest = false
test = false

[features]
entrypoints = []
spec = ["sdk/spec"]
default = ["dev"]
dev = ["sdk/dev"]

[dependencies]
sdk = { version = "0.11.3", registry = "groundhog", features = ["storage"] }

[dev-dependencies]
{{PROJECT_NAME}} = { path = ".", features = ["dev"] }
