[package]
name = "{{PROJECT_NAME}}"
version = "0.1.0"
edition = "2024"

[lib]
crate-type = ["rlib"]
doctest = false
test = false

# RV32 ELF bin wrapper. The name must stay the snake-case package name:
# `thruput build` looks for the ELF at `release/<snake_name>`.
# `required-features` keeps host `cargo build` / `cargo test` from building
# this no_std binary.
[[bin]]
name = "{{PROJECT_NAME_SNAKE}}"
path = "src/main.rs"
required-features = ["entrypoints"]
test = false
bench = false

# Three of these feature names are contracts with the toolchain — do not
# rename them:
# - `entrypoints`: the #[contract] macro keys guest entrypoint codegen on
#   this exact name, and `thruput build` compiles the rv32 bin with it.
# - `dev`: `thruput test` runs host tests with `--features dev`.
# - `thruput-integration-test`: `thruput test --integration` enables it.
[features]
entrypoints = []
dev = ["sdk/dev"]
thruput-integration-test = ["dep:groundhog-json-rpc-client", "dep:tokio"]

# `sdk` is declared per target because it needs `std` on the host and forbids
# it on the guest. Cargo resolves features per platform, so host `cargo build`
# / `cargo check` (and rust-analyzer) see a buildable crate without `dev`
# being a default feature, and the rv32 build stays `no_std`.
[target.'cfg(target_arch = "riscv32")'.dependencies]
sdk = { version = "={{SDK_VERSION}}", registry = "groundhog" }

[target.'cfg(not(target_arch = "riscv32"))'.dependencies]
sdk = { version = "={{SDK_VERSION}}", registry = "groundhog", features = ["std"] }
tokio = { version = "1", features = ["macros", "rt-multi-thread"], optional = true }

[target.'cfg(not(target_arch = "riscv32"))'.dependencies.groundhog-json-rpc-client]
version = "{{JSON_RPC_CLIENT_VERSION}}"
registry = "groundhog"
optional = true

# The self-dependency is deliberate: it turns the `dev` feature (and so
# `sdk/dev`, the native mock executor) on for `cargo test` builds only,
# keeping the library itself no_std for guest builds.
[dev-dependencies]
{{PROJECT_NAME}} = { path = ".", features = ["dev"] }
