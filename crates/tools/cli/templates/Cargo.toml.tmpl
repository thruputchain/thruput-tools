[package]
name = "{{PROJECT_NAME}}"
version = "0.1.0"
edition = "2024"

[lib]
crate-type = ["cdylib", "rlib"]
doctest = false
test = false

# RV32 ELF bin wrapper. The name must stay the snake-case package name:
# `groundhog build --target rv32` looks for the ELF at `release/<snake_name>`.
# `required-features` keeps host `cargo build` / `cargo test` (default
# features) from building this no_std binary; `test`/`bench` keep the host
# test harness from trying to link it when entrypoints is enabled.
[[bin]]
name = "{{PROJECT_NAME_SNAKE}}"
path = "src/main.rs"
required-features = ["entrypoints"]
test = false
bench = false

[features]
entrypoints = []
default = ["dev"]
dev = ["sdk/dev"]

[dependencies]
sdk = { version = "0.15.0", registry = "groundhog", features = ["storage"] }

[dev-dependencies]
{{PROJECT_NAME}} = { path = ".", features = ["dev"] }
