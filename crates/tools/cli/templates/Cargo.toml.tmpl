[package]
name = "{{PROJECT_NAME}}"
version = "0.1.0"
edition = "2024"

[lib]
crate-type = ["cdylib", "rlib"]
doctest = false
test = false

# RV32 ELF bin wrapper. The name must stay the snake-case package name:
# `groundhog build --target rv32` looks for the ELF at `release/<snake_name>`.
# `required-features` keeps host `cargo build` / `cargo test` and explicit WASM
# entrypoint builds from building this no_std binary.
[[bin]]
name = "{{PROJECT_NAME_SNAKE}}"
path = "src/main.rs"
required-features = ["rv32-entrypoints"]
test = false
bench = false

[features]
entrypoints = []
rv32-entrypoints = ["entrypoints"]
default = ["dev"]
dev = ["sdk/dev"]
groundhog-integration-test = ["dep:groundhog-json-rpc-client", "dep:tokio"]

[dependencies]
sdk = { version = "0.17.8", registry = "groundhog" }

[target.'cfg(not(any(target_arch = "wasm32", target_arch = "riscv32")))'.dependencies]
groundhog-json-rpc-client = { version = "0.6.2", registry = "groundhog", optional = true }
tokio = { version = "1", features = ["macros", "rt-multi-thread"], optional = true }

[dev-dependencies]
{{PROJECT_NAME}} = { path = ".", features = ["dev"] }
