use {{PROJECT_NAME_SNAKE}}::CounterClient;
use sdk::*;
use std::path::PathBuf;

static NONCE: SHA256Hash = sdk::sha256_static!(
    "{{PROJECT_NAME_UPPER_SNAKE}}_RV32_NONCE"
);

fn groundhog_artifact(file_name: &str) -> PathBuf {
    std::env::var_os("CARGO_TARGET_DIR")
        .map(PathBuf::from)
        .unwrap_or_else(|| PathBuf::from("target"))
        .join("groundhog")
        .join(file_name)
}

#[test]
#[ignore = "requires RV32 build — run via `groundhog test`"]
fn test_counter_rv32() {
    let contract = load_rv32_contract(
        groundhog_artifact("{{PROJECT_NAME_SNAKE}}.rv32a"),
    );
    let env = TestEnvironment::no_cost();
    let contract_hash =
        env.setup_create_contract(&contract);
    let call_addr = ContractAddress::named(
        "{{PROJECT_NAME_SNAKE}}_rv32",
    );

    let result = env.transact(|tx| {
        tx.call(&call_addr).run(|| {
            let addr = deploy_contract(
                &NONCE, &contract_hash,
            );
            let client =
                CounterClient::new(&addr);

            client.initialize(10);
            assert_eq!(client.get(), 10);

            client.increment(5);
            assert_eq!(client.get(), 15);

            client.decrement(3);
            assert_eq!(client.get(), 12);
        })
    });

    result.assert_success();
}
