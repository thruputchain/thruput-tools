use sdk::*;
use std::path::PathBuf;

static NONCE: SHA256Hash = sdk::sha256_static!(
    "{{PROJECT_NAME_UPPER_SNAKE}}_WASM_NONCE"
);

fn cargo_wasm_artifact(file_name: &str) -> PathBuf {
    std::env::var_os("CARGO_TARGET_DIR")
        .map(PathBuf::from)
        .unwrap_or_else(|| PathBuf::from("target"))
        .join("wasm32-unknown-unknown")
        .join("release")
        .join(file_name)
}

#[test]
#[ignore = "requires WASM build — run via `groundhog test`"]
fn test_deploy_wasm() {
    let contract = load_wasm_contract(
        cargo_wasm_artifact("{{PROJECT_NAME_SNAKE}}.wasm"),
    );
    let env = TestEnvironment::no_cost();
    let contract_hash =
        env.setup_create_contract(&contract);
    let call_addr = ContractAddress::named(
        "{{PROJECT_NAME_SNAKE}}_wasm",
    );

    let result = env.transact(|tx| {
        tx.call(&call_addr).run(|| {
            deploy_contract(
                &NONCE, &contract_hash,
            );
        })
    });

    result.assert_success();
}
