# Project-local Groundhog config.
#
# User-level defaults live in ~/.config/groundhog/config.toml.
# Profiles here merge with global profiles of the same name, and project
# aliases override global aliases.

default_profile = "local"

[profile.local]
network = "local"
# Set with `groundhog wallet use <NAME> --profile local`.
# default_wallet = "alice"

[profile.local.contracts]
# {{PROJECT_NAME}} = "CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAABSC4"

# [profile.local.wallets.alice]
# address = "CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAABSC4"
# owner_public_key = "GAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAWHF"

[profile.devnet]
network = "devnet"
# Set with `groundhog wallet use <NAME> --profile devnet`.
# default_wallet = "alice"

[profile.devnet.contracts]
# {{PROJECT_NAME}} = "CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAABSC4"

# [profile.devnet.wallets.alice]
# address = "CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAABSC4"
# owner_public_key = "GAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAWHF"
